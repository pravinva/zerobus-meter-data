# Environment Variables for Zerobus Meter Data Demo
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Databricks Workspace Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi1234567890abcdef...

# Unity Catalog Configuration
CATALOG=energy_australia_demo
SCHEMA_BRONZE=bronze
SCHEMA_SILVER=silver
SCHEMA_GOLD=gold

# Table Names
TABLE_METER_METADATA=meter_metadata
TABLE_METER_READINGS=live_meter_readings

# Data Generation Parameters (Optional - can override via CLI)
NUM_METERS=100000
NUM_DAYS=7
START_DATE=2025-11-09
BATCH_SIZE=1000
WORKERS=16

# Zerobus Ingestion Parameters (Optional - can override via CLI)
INGESTION_BATCH_SIZE=10000
INGESTION_WORKERS=16

# AWS Configuration (if running on EC2 or storing intermediate files in S3)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=ap-southeast-2

# Optional: Logging
LOG_LEVEL=INFO
